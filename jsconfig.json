{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "types": [
      "node"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "shared/**/*.js",
    "sim/**/*.js",
    "server/**/*.js",
    "client/**/*.js",
    "tools/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
